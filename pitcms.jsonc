{
  "schemaVersion": 1,
  "media": {
    "storagePath": "public/images",
    "publicPath": "/images"
  },
  "collections": [
    {
      "name": "freeArticles",
      "label": "【記事入力】フリー記事",
      "description": "フリー記事（一般記事・告知・イベント等）",
      "path": "content/free",
      "extension": "md",
      "fields": [
        {
          "name": "category",
          "type": "select",
          "label": "大カテゴリ",
          "required": true,
          "options": [
            {
              "value": "about",
              "label": "私たちについて"
            },
            {
              "value": "events",
              "label": "イベント・勉強会"
            }
          ]
        },
        {
          "name": "subcategory",
          "type": "select",
          "label": "サブカテゴリ",
          "required": true,
          "options": [
            {
              "value": "about_intro_message",
              "label": "【私たちについて】紹介・メッセージ"
            },
            {
              "value": "about_profile",
              "label": "【私たちについて】団体概要"
            },
            {
              "value": "about_people_org",
              "label": "【私たちについて】人事・組織"
            },
            {
              "value": "about_media",
              "label": "【私たちについて】広報・マスコミ登場"
            },
            {
              "value": "about_feedback",
              "label": "【私たちについて】頂いたご意見"
            },
            {
              "value": "about_other",
              "label": "【私たちについて】その他"
            },
            {
              "value": "events_advance",
              "label": "【イベント・勉強会】事前告知"
            },
            {
              "value": "events_study_library",
              "label": "【イベント・勉強会】スタディ・ライブラリ"
            },
            {
              "value": "events_party_library",
              "label": "【イベント・勉強会】イベント・ライブラリ"
            }
          ],
          "note": "この入力コレクションで使用するサブカテゴリだけを固定表示します。"
        },
        {
          "name": "title",
          "type": "text",
          "label": "タイトル",
          "required": true,
          "maxLength": 24,
          "note": "24文字以内。記事の主題を端的に入力してください。"
        },
        {
          "name": "subtitle",
          "type": "text",
          "label": "サブタイトル",
          "maxLength": 50,
          "note": "50文字以内。タイトルの補足や興味喚起ワードを入力してください。"
        },
        {
          "name": "summary",
          "type": "text",
          "label": "概略",
          "maxLength": 150,
          "note": "150文字以内。一覧画面に反映されます。"
        },
        {
          "name": "content",
          "type": "richtext",
          "label": "本文",
          "note": "ツールで見出し・文字装飾・改行などが可能です。"
        },
        {
          "name": "image1",
          "type": "image",
          "label": "アイキャッチ画像1"
        },
        {
          "name": "image2",
          "type": "image",
          "label": "アイキャッチ画像2"
        },
        {
          "name": "videoUrl",
          "type": "text",
          "label": "動画URL",
          "note": "ページ内で動画として表示するURLです。リンク参照URLとは別用途です。"
        },
        {
          "name": "linkLabel",
          "type": "text",
          "label": "リンク表示文字",
          "note": "リンクボタン等に表示する文字です。"
        },
        {
          "name": "linkUrl",
          "type": "text",
          "label": "リンク参照URL",
          "note": "サイト内または外部サイトへの遷移先URLです。動画URLとは別用途です。"
        },
        {
          "name": "eventAt",
          "type": "date",
          "label": "開催日時",
          "includeTime": true,
          "note": "イベント・勉強会の開催日時です。告知記事では掲載終了日時が未指定の場合、この日時を終了判定に使用します。"
        },
        {
          "name": "publishable",
          "type": "boolean",
          "label": "掲載可否",
          "default": true
        },
        {
          "name": "whatsNew",
          "type": "boolean",
          "label": "What's New表示",
          "default": true,
          "note": "ONの場合、What's Newの掲載候補になります。"
        },
        {
          "name": "publishedAt",
          "type": "date",
          "label": "掲載日時",
          "includeTime": true,
          "note": "一覧・新着順の基準となる掲載日時です。"
        },
        {
          "name": "publishStartAt",
          "type": "date",
          "label": "掲載開始日時",
          "includeTime": true,
          "note": "指定した場合、この日時まではサイトに表示しません。"
        },
        {
          "name": "publishEndAt",
          "type": "date",
          "label": "掲載終了日時",
          "includeTime": true,
          "note": "指定した場合、この日時以降はサイトに表示しません。"
        },
        {
          "name": "updatedAt",
          "type": "date",
          "label": "更新日時",
          "includeTime": true
        },
        {
          "name": "isDraft",
          "type": "boolean",
          "label": "下書き",
          "default": true
        }
      ],
      "layout": [
        [
          "category",
          "subcategory"
        ],
        [
          "title"
        ],
        [
          "subtitle"
        ],
        [
          "summary"
        ],
        [
          "image1",
          "image2"
        ],
        [
          "content"
        ],
        [
          "videoUrl"
        ],
        [
          "linkUrl",
          "linkLabel"
        ],
        [
          "eventAt"
        ],
        [
          "publishStartAt",
          "publishEndAt"
        ],
        [
          "publishable",
          "whatsNew"
        ]
      ],
      "pit": {
        "title": "title",
        "body": "content",
        "createdAt": "publishedAt",
        "updatedAt": "updatedAt",
        "draft": "isDraft",
        "defaultSortField": "_createdAt",
        "defaultSortOrder": "desc"
      }
    },
    {
      "name": "videoArticles",
      "label": "【記事入力】動画メイン記事",
      "description": "動画を主役にする記事",
      "path": "content/videos",
      "extension": "md",
      "fields": [
        {
          "name": "category",
          "type": "select",
          "label": "大カテゴリ",
          "required": true,
          "options": [
            {
              "value": "featured",
              "label": "推しネタ"
            },
            {
              "value": "events",
              "label": "イベント・勉強会"
            }
          ]
        },
        {
          "name": "subcategory",
          "type": "select",
          "label": "サブカテゴリ",
          "required": true,
          "options": [
            {
              "value": "featured_hakomono",
              "label": "【推しネタ】ハコモノ探偵団"
            },
            {
              "value": "featured_prices",
              "label": "【推しネタ】港区狂乱物価"
            },
            {
              "value": "featured_closure",
              "label": "【推しネタ】港区廃業"
            },
            {
              "value": "featured_employment_social",
              "label": "【推しネタ】雇用・社会問題を斬る"
            },
            {
              "value": "featured_promo",
              "label": "【推しネタ】プロモーション・その他"
            },
            {
              "value": "events_advance",
              "label": "【イベント・勉強会】事前告知"
            },
            {
              "value": "events_study_library",
              "label": "【イベント・勉強会】スタディ・ライブラリ"
            },
            {
              "value": "events_party_library",
              "label": "【イベント・勉強会】イベント・ライブラリ"
            }
          ],
          "note": "この入力コレクションで使用するサブカテゴリだけを固定表示します。"
        },
        {
          "name": "title",
          "type": "text",
          "label": "タイトル（任意）",
          "maxLength": 24,
          "note": "24文字以内。YouTube動画は原則YouTube側のタイトルを使用。非YouTube等で必要な場合のみ入力します。"
        },
        {
          "name": "image1",
          "type": "image",
          "label": "画像①（任意）",
          "note": "固定された小スペースに表示する自由画像。外部動画の指定ロゴ、オリジナル動画のQR等に使用できます。"
        },
        {
          "name": "note",
          "type": "textarea",
          "label": "備考",
          "note": "外部動画のクレジット・出典・指定表記、オリジナル動画の案内文など自由に入力できます。サイト上では「備考」という見出しは表示しません。"
        },
        {
          "name": "videoUrl",
          "type": "text",
          "label": "動画URL",
          "required": true,
          "note": "YouTube等の動画URLを入力してください。"
        },
        {
          "name": "publishable",
          "type": "boolean",
          "label": "掲載可否",
          "default": true
        },
        {
          "name": "whatsNew",
          "type": "boolean",
          "label": "What's New表示",
          "default": false,
          "note": "ONの場合、What's Newの掲載候補になります。"
        },
        {
          "name": "publishedAt",
          "type": "date",
          "label": "公開日",
          "includeTime": true,
          "note": "動画LPに表示する公開日です。"
        },
        {
          "name": "publishStartAt",
          "type": "date",
          "label": "掲載開始日時",
          "includeTime": true,
          "note": "指定した場合、この日時まではサイトに表示しません。"
        },
        {
          "name": "publishEndAt",
          "type": "date",
          "label": "掲載終了日時",
          "includeTime": true,
          "note": "指定した場合、この日時以降はサイトに表示しません。"
        },
        {
          "name": "updatedAt",
          "type": "date",
          "label": "更新日時",
          "includeTime": true
        },
        {
          "name": "isDraft",
          "type": "boolean",
          "label": "下書き",
          "default": true
        }
      ],
      "layout": [
        [
          "category",
          "subcategory"
        ],
        [
          "videoUrl"
        ],
        [
          "title"
        ],
        [
          "image1",
          "note"
        ],
        [
          "publishedAt"
        ],
        [
          "publishStartAt",
          "publishEndAt"
        ],
        [
          "publishable",
          "whatsNew",
          "isDraft"
        ]
      ],
      "pit": {
        "title": "title",
        "createdAt": "publishedAt",
        "updatedAt": "updatedAt",
        "draft": "isDraft",
        "defaultSortField": "_createdAt",
        "defaultSortOrder": "desc"
      }
    },
    {
      "name": "textQaArticles",
      "label": "【記事入力】テキスト・QA",
      "description": "テキスト情報・QA記事",
      "path": "content/text-qa",
      "extension": "md",
      "fields": [
        {
          "name": "category",
          "type": "select",
          "label": "大カテゴリ",
          "required": true,
          "options": [
            {
              "value": "about",
              "label": "私たちについて"
            },
            {
              "value": "qa",
              "label": "QA"
            }
          ]
        },
        {
          "name": "subcategory",
          "type": "select",
          "label": "サブカテゴリ",
          "required": true,
          "options": [
            {
              "value": "about_intro_message",
              "label": "【私たちについて】紹介・メッセージ"
            },
            {
              "value": "about_profile",
              "label": "【私たちについて】団体概要"
            },
            {
              "value": "about_people_org",
              "label": "【私たちについて】人事・組織"
            },
            {
              "value": "about_media",
              "label": "【私たちについて】広報・マスコミ登場"
            },
            {
              "value": "about_feedback",
              "label": "【私たちについて】頂いたご意見"
            },
            {
              "value": "about_other",
              "label": "【私たちについて】その他"
            },
            {
              "value": "qa_membership",
              "label": "【Q&A】会員に関して"
            },
            {
              "value": "qa_donation",
              "label": "【Q&A】寄付に関して"
            },
            {
              "value": "qa_events",
              "label": "【Q&A】勉強会・イベントに関して"
            },
            {
              "value": "qa_party",
              "label": "【Q&A】党に対して"
            },
            {
              "value": "qa_policy",
              "label": "【Q&A】政策に対して"
            },
            {
              "value": "qa_other",
              "label": "【Q&A】その他"
            }
          ],
          "note": "この入力コレクションで使用するサブカテゴリだけを固定表示します。"
        },
        {
          "name": "title",
          "type": "text",
          "label": "タイトル",
          "required": true,
          "maxLength": 24,
          "note": "24文字以内。記事の主題を端的に入力してください。"
        },
        {
          "name": "content",
          "type": "richtext",
          "label": "本文",
          "note": "ツールで見出し・文字装飾・改行などが可能です。"
        },
        {
          "name": "answerSummary",
          "type": "textarea",
          "label": "回答概略",
          "note": "QAの回答を短く要約します。テキスト情報記事では空欄で構いません。"
        },
        {
          "name": "answer",
          "type": "richtext",
          "disabledFeatures": [
            "image"
          ],
          "label": "回答",
          "note": "QAの回答本文です。テキスト情報記事では空欄で構いません。"
        },
        {
          "name": "linkLabel",
          "type": "text",
          "label": "リンク表示文字",
          "note": "リンクボタン等に表示する文字です。"
        },
        {
          "name": "linkUrl",
          "type": "text",
          "label": "リンク参照URL",
          "note": "サイト内または外部サイトへの遷移先URLです。動画URLとは別用途です。"
        },
        {
          "name": "articleType",
          "type": "select",
          "label": "記事タイプ",
          "required": true,
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "テキスト情報"
            },
            {
              "value": "qa",
              "label": "QA"
            }
          ]
        },
        {
          "name": "publishable",
          "type": "boolean",
          "label": "掲載可否",
          "default": true
        },
        {
          "name": "whatsNew",
          "type": "boolean",
          "label": "What's New表示",
          "default": true,
          "note": "ONの場合、What's Newの掲載候補になります。"
        },
        {
          "name": "publishedAt",
          "type": "date",
          "label": "掲載日時",
          "includeTime": true,
          "note": "一覧・新着順の基準となる掲載日時です。"
        },
        {
          "name": "publishStartAt",
          "type": "date",
          "label": "掲載開始日時",
          "includeTime": true,
          "note": "指定した場合、この日時まではサイトに表示しません。"
        },
        {
          "name": "publishEndAt",
          "type": "date",
          "label": "掲載終了日時",
          "includeTime": true,
          "note": "指定した場合、この日時以降はサイトに表示しません。"
        },
        {
          "name": "updatedAt",
          "type": "date",
          "label": "更新日時",
          "includeTime": true
        },
        {
          "name": "isDraft",
          "type": "boolean",
          "label": "下書き",
          "default": true
        }
      ],
      "layout": [
        [
          "category",
          "subcategory"
        ],
        [
          "articleType"
        ],
        [
          "title"
        ],
        [
          "content"
        ],
        [
          "answerSummary"
        ],
        [
          "answer"
        ],
        [
          "linkUrl",
          "linkLabel"
        ],
        [
          "publishStartAt",
          "publishEndAt"
        ],
        [
          "publishable",
          "whatsNew"
        ]
      ],
      "pit": {
        "title": "title",
        "body": "content",
        "createdAt": "publishedAt",
        "updatedAt": "updatedAt",
        "draft": "isDraft",
        "defaultSortField": "_createdAt",
        "defaultSortOrder": "desc"
      }
    },
    {
      "name": "lpDirectLinks",
