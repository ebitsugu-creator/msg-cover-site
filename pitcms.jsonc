{
  "schemaVersion": 1,
  "collections": [
    {
      "name": "aboutArticles",
      "label": "私たちについて",
      "description": "私たちについての記事",
      "path": "content/about",
      "extension": "md",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "label": "タイトル",
          "required": true
        },
        {
          "name": "subtitle",
          "type": "text",
          "label": "サブタイトル"
        },
        {
          "name": "summary",
          "type": "textarea",
          "label": "概要"
        },
        {
          "name": "content",
          "type": "richtext",
          "label": "本文"
        },
        {
          "name": "image1",
          "type": "image",
          "label": "画像1"
        },
        {
          "name": "image2",
          "type": "image",
          "label": "画像2"
        },
        {
          "name": "videoUrl",
          "type": "text",
          "label": "動画URL"
        },
        {
          "name": "linkLabel",
          "type": "text",
          "label": "リンク表示文字"
        },
        {
          "name": "linkUrl",
          "type": "text",
          "label": "リンク参照URL"
        },
        {
          "name": "eventAt",
          "type": "date",
          "label": "開催日時",
          "includeTime": true
        },
        {
          "name": "category",
          "type": "select",
          "label": "大カテゴリ",
          "required": true,
          "default": "about",
          "options": [
            {
              "value": "about",
              "label": "私たちについて"
            }
          ]
        },
        {
          "name": "subcategory",
          "type": "select",
          "label": "サブカテゴリ",
          "required": true,
          "options": [
            {
              "value": "about_intro_message",
              "label": "紹介・メッセージ"
            },
            {
              "value": "about_profile",
              "label": "団体概要"
            },
            {
              "value": "about_people_org",
              "label": "人事・組織"
            },
            {
              "value": "about_media",
              "label": "広報・マスコミ登場"
            },
            {
              "value": "about_feedback",
              "label": "頂いたご意見"
            },
            {
              "value": "about_other",
              "label": "その他"
            }
          ]
        },
        {
          "name": "publishable",
          "type": "boolean",
          "label": "掲載可否",
          "default": true
        },
        {
          "name": "whatsNew",
          "type": "boolean",
          "label": "What's New表示",
          "default": true
        },
        {
          "name": "publishedAt",
          "type": "date",
          "label": "掲載日時",
          "includeTime": true
        },
        {
          "name": "publishStartAt",
          "type": "date",
          "label": "掲載開始日時",
          "includeTime": true
        },
        {
          "name": "publishEndAt",
          "type": "date",
          "label": "掲載終了日時",
          "includeTime": true
        },
        {
          "name": "isDraft",
          "type": "boolean",
          "label": "下書き",
          "default": true
        }
      ],
      "pit": {
        "title": "title",
        "body": "content",
        "createdAt": "publishedAt",
        "draft": "isDraft",
        "defaultSortField": "_createdAt",
        "defaultSortOrder": "desc"
      }
    },
