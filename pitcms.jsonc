{
  "schemaVersion": 1,
  "collections": [
    {
      "name": "freeArticles",
      "label": "フリー記事",
      "description": "フリー記事（一般記事・告知・イベント等）",
      "path": "content/free",
      "extension": "md",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "label": "タイトル",
          "required": true
        },
        {
          "name": "subtitle",
          "type": "text",
          "label": "サブタイトル"
        },
        {
          "name": "summary",
          "type": "textarea",
          "label": "概要"
        },
        {
          "name": "content",
          "type": "richtext",
          "label": "本文"
        },
        {
          "name": "image1",
          "type": "image",
          "label": "画像1"
        },
        {
          "name": "image2",
          "type": "image",
          "label": "画像2"
        },
        {
          "name": "videoUrl",
          "type": "text",
          "label": "動画URL"
        },
        {
          "name": "linkLabel",
          "type": "text",
          "label": "リンク表示文字"
        },
        {
          "name": "linkUrl",
          "type": "text",
          "label": "リンク参照URL"
        },
        {
          "name": "eventAt",
          "type": "date",
          "label": "開催日時",
          "includeTime": true
        },
        {
          "name": "category",
          "type": "select",
          "label": "大カテゴリ",
          "required": true,
          "options": [
            {
              "value": "about",
              "label": "私たちについて"
            },
            {
              "value": "qa",
              "label": "QA"
            },
            {
              "value": "events",
              "label": "イベント・勉強会"
            },
            {
              "value": "video",
              "label": "動画"
            }
          ]
        },
        {
          "name": "subcategory",
          "type": "select",
          "label": "サブカテゴリ",
          "required": true,
          "options": [
            {
              "value": "about_intro_message",
              "label": "【私たちについて】紹介・メッセージ"
            },
            {
              "value": "about_profile",
              "label": "【私たちについて】団体概要"
            },
            {
              "value": "about_people_org",
              "label": "【私たちについて】人事・組織"
            },
            {
              "value": "about_media",
              "label": "【私たちについて】広報・マスコミ登場"
            },
            {
              "value": "about_feedback",
              "label": "【私たちについて】頂いたご意見"
            },
            {
              "value": "about_other",
              "label": "【私たちについて】その他"
            },
            {
              "value": "qa_membership",
              "label": "【QA】会員に関して"
            },
            {
              "value": "qa_donation",
              "label": "【QA】寄付に関して"
            },
            {
              "value": "qa_events",
              "label": "【QA】勉強会・イベントに関して"
            },
            {
              "value": "qa_party",
              "label": "【QA】党に対して"
            },
            {
              "value": "qa_policy",
              "label": "【QA】政策に対して"
            },
            {
              "value": "qa_other",
              "label": "【QA】その他"
            },
            {
              "value": "events_study",
              "label": "【イベント・勉強会】勉強会"
            },
            {
              "value": "events_party",
              "label": "【イベント・勉強会】パーティ､交流"
            },
            {
              "value": "events_party_policy_other",
              "label": "【イベント・勉強会】党運営､政策関連､その他"
            },
            {
              "value": "video_city_oddities",
              "label": "【動画】都会にこんなものいる？"
            },
            {
              "value": "video_minato_prices",
              "label": "【動画】クレイジーな港区物価"
            },
            {
              "value": "video_minato_closures",
              "label": "【動画】港区廃業という闇"
            },
            {
              "value": "video_members",
              "label": "【動画】メンバー紹介"
            },
            {
              "value": "video_other",
              "label": "【動画】その他"
            }
          ]
        },
        {
          "name": "publishable",
          "type": "boolean",
          "label": "掲載可否",
          "default": true
        },
        {
          "name": "whatsNew",
          "type": "boolean",
          "label": "What's New表示",
          "default": true
        },
        {
          "name": "publishedAt",
          "type": "date",
          "label": "掲載日時",
          "includeTime": true
        },
        {
          "name": "publishStartAt",
          "type": "date",
          "label": "掲載開始日時",
          "includeTime": true
        },
        {
          "name": "publishEndAt",
          "type": "date",
          "label": "掲載終了日時",
          "includeTime": true
        },
        {
          "name": "isDraft",
          "type": "boolean",
          "label": "下書き",
          "default": true
        }
      ],
      "pit": {
        "title": "title",
        "body": "content",
        "createdAt": "publishedAt",
        "draft": "isDraft",
        "defaultSortField": "_createdAt",
        "defaultSortOrder": "desc"
      }
    },
