        },
        {
          "name": "publishedAt",
          "type": "date",
          "label": "掲載日時",
          "includeTime": true,
          "note": "一覧・新着順の基準となる掲載日時です。"
        },
        {
          "name": "publishStartAt",
          "type": "date",
          "label": "掲載開始日時",
          "includeTime": true,
          "note": "指定した場合、この日時まではサイトに表示しません。"
        },
        {
          "name": "publishEndAt",
          "type": "date",
          "label": "掲載終了日時",
          "includeTime": true,
          "note": "指定した場合、この日時以降はサイトに表示しません。"
        },
        {
          "name": "updatedAt",
          "type": "date",
          "label": "更新日時",
          "includeTime": true
        },
        {
          "name": "isDraft",
          "type": "boolean",
          "label": "下書き",
          "default": true
        }
      ],
      "layout": [
        [
          "category",
          "subcategory"
        ],
        [
          "title"
        ],
        [
          "summary"
        ],
        [
          "image1",
          "image2"
        ],
        [
          "videoUrl"
        ],
        [
          "linkUrl",
          "linkLabel"
        ],
        [
          "eventAt",
          "publishStartAt",
          "publishEndAt"
        ],
        [
          "publishable",
          "whatsNew"
        ]
      ],
      "pit": {
        "title": "title",
        "createdAt": "publishedAt",
        "updatedAt": "updatedAt",
        "draft": "isDraft",
        "defaultSortField": "_createdAt",
        "defaultSortOrder": "desc"
      }
    },
    {
      "name": "subcategoryManagement",
      "label": "【付加機能】サブカテゴリ管理",
      "description": "サブカテゴリの追加・名称変更・利用停止を管理します。削除せず、利用停止を使用してください。",
      "path": "content/subcategories",
      "extension": "json",
      "generateFilename": true,
      "fields": [
        {
          "name": "category",
          "type": "select",
          "label": "大カテゴリ",
          "required": true,
          "options": [
            {
              "value": "about",
              "label": "私たちについて"
            },
            {
              "value": "qa",
              "label": "QA"
            },
            {
              "value": "events",
              "label": "イベント・勉強会"
            },
            {
              "value": "featured",
              "label": "推しネタ"
            }
          ]
        },
        {
          "name": "label",
          "type": "text",
          "label": "管理・表示名",
          "required": true,
          "note": "例：【推しネタ】ハコモノ探偵団。名称変更はこの欄だけを変更します。"
        },
        {
          "name": "status",
          "type": "select",
          "label": "状態",
          "required": true,
          "default": "active",
          "options": [
            {
              "value": "active",
              "label": "使用中"
            },
            {
              "value": "inactive",
              "label": "利用停止"
            }
          ]
        },
        {
          "name": "description",
          "type": "textarea",
          "label": "説明文",
          "note": "サブカテゴリ見出しに説明を出す場合に入力します。空欄でも構いません。"
        },
        {
          "name": "displayOrder",
          "type": "number",
          "label": "表示順",
          "min": 0,
          "note": "小さい数字から順に表示します。一覧画面のドラッグ操作でも変更できます。"
        },
        {
          "name": "showBackNumber",
          "type": "boolean",
          "label": "Back Numberを表示",
          "default": true
        },
        {
          "name": "updatedAt",
          "type": "date",
          "label": "更新日時",
          "includeTime": true
        }
      ],
      "layout": [
        [
          "category",
          "status"
        ],
        [
          "label"
        ],
        [
          "description"
        ],
        [
          "displayOrder",
          "showBackNumber"
        ]
      ],
      "pit": {
        "title": "label",
        "updatedAt": "updatedAt",
        "order": "displayOrder"
      }
    },
    {
      "name": "auxiliaryDisplay",
      "label": "【付加機能】MVボタン・TOPテキストバナー",
      "description": "【入力ルール】機能選択でどちらかを選び、該当する文字欄だけ入力してください。MVボタンは1行6文字×2行まで、TOPテキストバナーは24文字以内です。TOPテキストバナーは有効な登録のうち新しい2件を固定枠として使用します。",
      "path": "content/auxiliary-display",
      "extension": "json",
      "generateFilename": true,
      "fields": [
        {
          "name": "featureType",
          "type": "select",
          "label": "機能選択",
          "required": true,
          "options": [
            {
              "value": "mv_button",
              "label": "MVボタン"
            },
            {
              "value": "top_text_banner",
              "label": "TOPテキストバナー"
            }
          ],
          "note": "【重要】選んだ機能に対応する文字欄だけ入力してください。使わない側は空欄で構いません。"
        },
        {
          "name": "mvLine1",
          "type": "text",
          "label": "MVボタン 1行目",
          "maxLength": 6,
          "note": "MVボタンを選んだ場合のみ入力。6文字以内。"
        },
        {
          "name": "mvLine2",
          "type": "text",
          "label": "MVボタン 2行目",
          "maxLength": 6,
          "note": "MVボタンを選んだ場合のみ入力。6文字以内。空欄なら1行表示として扱えます。"
        },
        {
          "name": "topBannerText",
          "type": "text",
          "label": "TOPテキストバナー文言",
          "maxLength": 24,
          "note": "TOPテキストバナーを選んだ場合のみ入力。24文字以内。スマホでは原則2行表示です。"
        },
        {
          "name": "linkUrl",
          "type": "text",
          "label": "リンク先URL",
          "required": true,
          "note": "クリック時の遷移先URLを入力します。サイト内・外部URLのどちらも指定できます。"
        },
        {
          "name": "publishable",
          "type": "boolean",
          "label": "掲載可否",
          "default": true
        },
        {
          "name": "publishStartAt",
          "type": "date",
          "label": "掲載開始日時",
          "includeTime": true,
          "note": "指定した場合、この日時から表示対象になります。"
        },
        {
          "name": "publishEndAt",
          "type": "date",
          "label": "掲載終了日時",
          "includeTime": true,
          "note": "指定した場合、この日時以降は表示対象から外れます。"
        },
        {
          "name": "updatedAt",
          "type": "date",
          "label": "更新日時",
          "includeTime": true
        }
      ],
      "layout": [
        [
          "featureType"
        ],
        [
          "mvLine1",
          "mvLine2"
        ],
        [
          "topBannerText"
        ],
        [
          "linkUrl"
        ],
        [
          "publishStartAt",
          "publishEndAt"
        ],
        [
          "publishable"
        ]
      ],
      "pit": {
        "updatedAt": "updatedAt",
        "defaultSortField": "_createdAt",
        "defaultSortOrder": "desc"
      }
    }
  ]
}
