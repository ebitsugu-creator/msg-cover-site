          "type": "image",
          "label": "アイキャッチ画像1"
        },
        {
          "name": "image2",
          "type": "image",
          "label": "アイキャッチ画像2"
        },
        {
          "name": "videoUrl",
          "type": "text",
          "label": "動画URL",
          "note": "必要な場合のみ入力します。LPの遷移先はリンク参照URLに入力してください。"
        },
        {
          "name": "linkLabel",
          "type": "text",
          "label": "リンク表示文字",
          "note": "リンクボタン等に表示する文字です。"
        },
        {
          "name": "linkUrl",
          "type": "text",
          "label": "LP直リンクURL",
          "required": true,
          "note": "画像・タイトルのクリック先となるLPのURLです。"
        },
        {
